ipami", "source_name": "SEED_DEMO", "evidence_level": 3, "media": [], "origin": "CURATED", "scores": {"rerank": 0.84, "rrf": 0.0318, "lex_rank": 2, "vec_rank": 3, "cosine": 0.71}}, {"id": 3, "kind": "SOLUTION", "rank": 3, "title": "Sąsiedzka Sieć Wsparcia – wolontariat sąsiedzki", "summary": "Mieszkańcy osiedla i sołectwa umawiają się na regularne odwiedziny u starszych sąsiadów, drobne zakupy i wspólne spacery.", "organization": "Stowarzyszenie Dobre Sąsiedztwo", "gmina": "Zielonki", "powiat": "krakowski", "category": "LONELINESS", "category_label_pl": "Samotność i izolacja społeczna", "tags": ["wolontariat sąsiedzki", "seniorzy", "samotność", "odwiedziny", "sąsiedzi"], "target_group": "samotne osoby starsze", "cost_range": "20–50 tys. zł rocznie", "implementation_steps": ["Zatrudnienie koordynatora", "Kampania informacyjna w parafii, sklepach i na grupie mieszkańców", "Rekrutacja i szkolenie wolontariuszy", "Dobieranie par senior–wolontariusz", "Comiesięczne spotkania integracyjne"], "source_url": "https://example.org/seed-demo/siec-sasiedzka-zielonki", "source_name": "SEED_DEMO", "evidence_level": 3, "media": [], "origin": "CURATED", "scores": {"rerank": 0.77, "rrf": 0.031, "lex_rank": 4, "vec_rank": 2, "cosine": 0.73}}], "also_see": [{"id": 5, "kind": "SOLUTION", "rank": 4, "title": "Kawiarenka Międzypokoleniowa w bibliotece", "summary": "Cotygodniowe spotkania seniorów i licealistów przy kawie: rozmowy, gry planszowe, wspólne czytanie i nagrywanie wspomnień.", "organization": "Stowarzyszenie Most Pokoleń", "gmina": "Tarnów", "powiat": "Tarnów", "category": "LONELINESS", "category_label_pl": "Samotność i izolacja społeczna", "tags": ["międzypokoleniowe", "seniorzy", "młodzież", "biblioteka", "samotność"], "target_group": "seniorzy i młodzież", "cost_range": "do 5 tys. zł", "implementation_steps": ["Porozumienie biblioteki ze szkołą", "Ustalenie stałego terminu", "Plakaty w klatkach schodowych i przychodni", "Prowadzenie spotkań przez bibliotekarkę i opiekuna wol
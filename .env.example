# Splot – Moduł 1 (Matchmaking społeczny). Skopiuj do .env: `cp .env.example .env`.
# Wartości poniżej = domyślne z api/config.py (sekcja 11 specyfikacji).

# --- Połączenie ---
# Lokalnie (make dev / make ingest) host = localhost; w docker-compose serwis api nadpisuje host na `db`.
DATABASE_URL=postgresql+asyncpg://splot:splot@localhost:5432/splot

# --- Klucze dostawców (puste = provider niedostępny) ---
OPENAI_API_KEY=
COHERE_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddingi (ADR-004, ADR-015) ---
# openai = jedyna implementacja produkcyjna (text-embedding-3-large, dimensions=1024).
# hash   = TRYB DEWELOPERSKI bez kluczy: deterministyczny wektor z haszowanych n-gramów znakowych,
#          bez sieci, jakość wyszukiwania semantycznego tylko orientacyjna.
# Korpus i zapytania muszą być liczone tym samym providerem — po zmianie: make reset-db && make ingest.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
# Nie zmieniaj (ADR-004) — walidator odrzuci inną wartość.
EMBEDDING_DIM=1024
# Wielkość partii w ingeście
EMBEDDING_BATCH_SIZE=64
# Prefiksy `query: ` / `passage: ` tylko dla modeli E5; dla OpenAI puste.
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=

# --- Reranking ---
# cohere | noop
RERANK_PROVIDER=cohere
RERANK_MODEL=rerank-v3.5
# false => kolejność RRF jest ostateczna, bramka liczona z cosinusa (MIN_COSINE_SCORE)
RERANK_ENABLED=true

# --- Pipeline wyszukiwania ---
# Stała fuzji RRF
RRF_K=60
# Wielkość listy z każdego toru (leksykalny, semantyczny)
CANDIDATES_PER_TRACK=20
# Chunki pobierane przed kolapsem do rozwiązań
VECTOR_OVERFETCH=60
# Kandydaci po fuzji przekazywani do rerankera
RERANK_TOP_N=10
# Karty główne
ANSWER_TOP_N=3
# „Zobacz też”; wymagane ANSWER_TOP_N + ALSO_SEE_N <= RERANK_TOP_N
ALSO_SEE_N=5
# Próg bramki „nie wiem” z rerankerem
MIN_RERANK_SCORE=0.35
# Próg bramki bez rerankera + próg wpisów wiedzy
MIN_COSINE_SCORE=0.50
# Maks. wpisów wiedzy w `context`; 0 wyłącza
KNOWLEDGE_TOP_N=2

# --- Zgłoszenia ---
# Cosinus, od którego zgłoszenia są „podobne”
SIMILAR_REPORT_THRESHOLD=0.82
# Limit GET /api/reports/{id}/similar
SIMILAR_REPORTS_LIMIT=20

# --- Tryb hash (dev, bez kluczy API) — progi skalibrowane w T25 (docs/modules/01-matchmaking/module-1-calibration.md) ---
# Wartości wyżej dotyczą OpenAI/Cohere (startowe, do kalibracji po dodaniu kluczy).
# Provider `hash` daje cosinusy w innej skali — przy EMBEDDING_PROVIDER=hash odkomentuj:
# EMBEDDING_PROVIDER=hash
# RERANK_ENABLED=false
# LLM_ENABLED=false
# MIN_COSINE_SCORE=0.28
# SIMILAR_REPORT_THRESHOLD=0.38
# Ile strumień czeka na zapis zgłoszenia przed `report_saved` (s)
SAVE_WAIT_SECONDS=2.0

# --- Generacja (LLM: streszczenie M1, raport M4, asystent M3 — ADR-020) ---
# false => same karty, bez streszczenia
LLM_ENABLED=true
# openai (domyślnie, ten sam OPENAI_API_KEY co embeddingi) | anthropic (wymaga ANTHROPIC_API_KEY)
LLM_PROVIDER=openai
OPENAI_LLM_MODEL=gpt-6-luna
# none | low | medium | high | xhigh | max — tokeny rozumowania wliczają się do limitów wyjścia
OPENAI_LLM_REASONING_EFFORT=none
# Model Anthropic — tylko przy LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=400

# --- Przetwarzanie zapytania ---
# Obcięcie zapytania (znaki)
MAX_QUERY_CHARS=2000
# Poniżej tylu słów treściowych zapytanie jest `too_vague`
VAGUE_MIN_WORDS=4
# Limit słów w tsquery
MAX_TSQUERY_TERMS=15
# Obcięcie dokumentu dla rerankera (znaki)
RERANK_DOC_CHARS=2000
# Fragment najlepszego chunku w kontekście promptu streszczenia (znaki)
ANSWER_FRAGMENT_CHARS=800

# --- Chunkowanie (znaki) ---
CHUNK_TARGET_CHARS=1200
CHUNK_OVERLAP_CHARS=150
CHUNK_MIN_BODY_CHARS=400

# --- HTTP ---
# Lista originów po przecinku
CORS_ORIGINS=http://localhost:5173
# false wyłącza GET /api/search (treść zapytania trafia do URL i logów proxy)
SEARCH_ENDPOINT_ENABLED=true

# --- Moduł 2: Zasobnik wiedzy ---
# Rozwiązania w sekcji „Co już działa” na stronie wyzwania
CHALLENGE_TOP_SOLUTIONS=6
# Limit raportów i osobno materiałów na stronie wyzwania
CHALLENGE_TOP_KNOWLEDGE=6
# Minimum niedopasowanych zgłoszeń, od którego wyzwanie może być luką
COVERAGE_GAP_MIN_UNMATCHED=3
# Poniżej tylu opublikowanych rozwiązań wyzwanie może być luką
COVERAGE_GAP_MAX_SOLUTIONS=5
# Prefiks tagu grupy „dla kogo” (ROPS)
ROPS_GROUP_TAG_PREFIX="ROPS: "

# --- Różne ---
# Katalog słowników (względem katalogu repozytorium)
DATA_DIR=data
LOG_LEVEL=INFO

# --- Moduł 4: Tester innowacji ---
# false = Hub działa bez LLM (statystyki + anonimowe komentarze)
M4_AI_ENABLED=false
M4_AI_PROMPT_VERSION=m4-report-v1
M4_AI_FIT_PROMPT_VERSION=m4-fit-v2
M4_AI_MAX_TOKENS=1200
M4_SMALL_SAMPLE_THRESHOLD=3
# Limit aktywnych zgłoszeń (SUBMITTED/ACCEPTED) jednego testera (znormalizowany e-mail)
M4_MAX_ACTIVE_APPLICATIONS=3
# Maks. długość motywacji testera oraz komentarza/propozycji w ankiecie (znaki)
M4_MOTIVATION_MAX_CHARS=4000
M4_COMMENT_MAX_CHARS=4000
# Maks. liczba ankiet przekazanych do raportu AI
M4_REPORT_FEEDBACK_MAX=100

# --- Moduł 3: Kreator pomysłów ---
# Dostawca, model, klucz i wyłącznik LLM: LLM_PROVIDER, OPENAI_LLM_MODEL / LLM_MODEL, LLM_ENABLED (wyżej).
# false = asystent zwraca available=false, reszta Kreatora działa
# M3_ASSIST_ENABLED=true
# M3_ASSIST_MAX_TOKENS=1500
# M3_ASSIST_DRAFT_MAX_TOKENS=2500
# M3_ASSIST_TIMEOUT_SECONDS=30.0
# M3_ASSIST_MAX_QUESTIONS=3
# M3_ASSIST_MAX_SUGGESTIONS=5
# Liczba podobnych innowacji przy pomyśle
# IDEA_SIMILAR_LIMIT=3
# Limity Social Canvas
# CANVAS_LIST_MAX_ITEMS=12
# CANVAS_ITEM_MAX_CHARS=300
# CANVAS_TEXT_MAX_CHARS=2000
# CANVAS_PARTNERS_MAX=15
# Limity wniosku grantowego
# APPLICATION_TEXT_MAX_CHARS=6000
# APPLICATION_BUDGET_MAX_ROWS=30
# true = nabory otwarte niezależnie od dat (demo)
# KREATOR_CALLS_IGNORE_DATES=false
